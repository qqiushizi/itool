// itool 项目流程图 (Graphviz DOT)
// 与 README.md 中的 Mermaid 流程图保持一致, 用于生成 docs/itool-flow.png
// 重新生成:  dot -Tpng -Gdpi=120 docs/itool-flow.dot -o docs/itool-flow.png
digraph itool {
  graph [
    rankdir=TB
    splines=ortho
    bgcolor="#ffffff"
    fontname="PingFang SC"
    fontsize=16
    nodesep=0.45
    ranksep=0.55
    pad=0.3
  ];
  node [
    shape=box
    style="rounded,filled"
    fontname="PingFang SC"
    fontsize=14
    fontcolor="#24292f"
    color="#d0d7de"
    fillcolor="#f6f8fa"
    margin="0.28,0.16"
  ];
  edge [
    color="#57606a"
    fontname="PingFang SC"
    fontsize=12
  ];

  // ===== 两个入口 =====
  L [label="本地用户\nbash itool.sh", shape=ellipse, fillcolor="#ddf4ff", color="#54aeff"];
  T [label="itool.sh\n终端文件夹导航器 TUI"];
  R [label="远程机器 B\ncurl -s .../menu | bash", shape=ellipse, fillcolor="#ddf4ff", color="#54aeff"];
  C [label="menu\n远程客户端模板"];
  S [label="itool-server.py\nHTTP 服务（只读）\n/menu · /api/menu · /api/pack · /api/cat"];

  // ===== 仓库主体 =====
  REPO [label="脚本仓库（顶层目录）\na.framework · c.precision · d.ops_develop · e.environment\nf.installation · g.collectlogs · h.auto-test · p.practise · w.windows", fillcolor="#fff8c5", color="#d4a72c"];

  // ===== 算子开发工作流 =====
  subgraph cluster_ops {
    label="d.ops_develop 算子开发工作流";
    style="rounded,filled";
    color="#d0d7de";
    fillcolor="#ffffff";
    fontcolor="#57606a";
    fontsize=15;

    S1 [label="① a.check_cann\n服务器 CANN 检查", fillcolor="#dafbe1", color="#2da44e"];
    S2 [label="② c.install_cann\nCANN 安装 / source 激活", fillcolor="#dafbe1", color="#2da44e"];
    S3 [label="③ a.pull_image\nquay 可视化选 tag", fillcolor="#dafbe1", color="#2da44e"];
    S4 [label="④ b.run_container\n容器实例化 + 起容器脚本", fillcolor="#dafbe1", color="#2da44e"];
    S5 [label="⑤ c.check_in_container\n进容器检查软件包", fillcolor="#dafbe1", color="#2da44e"];
    S6 [label="⑥ c.design\n需求分析 → op.json", fillcolor="#dafbe1", color="#2da44e"];
    S7 [label="⑦ d.scaffold\nmsopgen / ops-transformer / torchbind", fillcolor="#dafbe1", color="#2da44e"];
  }

  // ===== 连线 =====
  L -> T;
  R -> C -> S;
  T -> REPO;
  S -> REPO;
  REPO -> S1;
  S1 -> S2 -> S3 -> S4 -> S5 -> S6 -> S7;
}
