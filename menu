#!/bin/bash
#
# menu - itool 远程客户端模板
#
# 推荐用法 (服务端自动注入 SERVER_URL):
#     curl -s http://<server-A>:5170/menu | bash
#
# 也可手动指定服务器地址:
#     curl -s http://<server-A>:5170/menu | bash -s -- http://<server-A>:5170
#     ITOOL_SERVER=http://<server-A>:5170 bash menu
#
# 关键: 通过 `curl | bash` 运行时 stdin 是管道, 不能用于按键读取。
# 所有终端交互 (菜单按键 / run.sh 的 read) 都显式走 /dev/tty。
#
# SERVER_URL 占位符由服务端在 /menu 返回时替换。
# 设置 ITOOL_TOKEN 时可使用 server.sh 生成的 token 跳过密码登录。

# ---------- 解析服务器地址 ----------
if [[ -n "$ITOOL_SERVER" ]]; then
    SERVER_URL="$ITOOL_SERVER"
elif [[ -n "$1" ]]; then
    SERVER_URL="$1"
else
    SERVER_URL="__SERVER_URL__"
fi
if [[ -z "$SERVER_URL" || "$SERVER_URL" != http* ]]; then
    echo "未指定服务器地址。" >&2
    echo "用法: curl -s http://<server>:5170/menu | bash" >&2
    exit 1
fi
AUTH_HEADER=()
if [[ -n "$ITOOL_TOKEN" ]]; then
    AUTH_HEADER=(--header "Authorization: Bearer $ITOOL_TOKEN")
fi

MAX_DEPTH=20

# 颜色
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; WHITE='\033[1;37m'; DIM='\033[2m'; RESET='\033[0m'

_sourced=0
(return 0 2>/dev/null) && _sourced=1

# ---------- 终端检查 ----------
if ! { : < /dev/tty > /dev/tty; } 2>/dev/null; then
    echo -e "${RED}需要交互式终端 (无法访问 /dev/tty)。${RESET}" >&2
    echo "请在真实终端中运行: curl -s http://<server>:5170/menu | bash" >&2
    exit 1
fi

old_tty=""
save_tty() { old_tty=$(stty -g < /dev/tty 2>/dev/null); }
restore_tty() {
    if [[ -n "$old_tty" ]]; then
        stty "$old_tty" < /dev/tty 2>/dev/null
        clear
    fi
}
trap 'restore_tty' EXIT INT TERM

# ---------- 密码或临时 token 登录 ----------
read_password() {
    local password="" char=""
    echo -ne "  ${WHITE}密码: ${RESET}" > /dev/tty
    while true; do
        IFS= read -r -s -n 1 char < /dev/tty
        if [[ -z "$char" ]]; then
            break
        fi
        case "$char" in
            $'\b'|$'\177')
                if [[ -n "$password" ]]; then
                    password="${password%?}"
                    echo -ne '\b \b' > /dev/tty
                fi
                ;;
            *)
                if [[ ${#password} -lt 1024 ]]; then
                    password+="$char"
                    echo -n '*' > /dev/tty
                fi
                ;;
        esac
    done
    echo > /dev/tty
    REPLY="$password"
}

authenticate() {
    local attempt password response status token
    if [[ -n "$ITOOL_TOKEN" ]]; then
        return 0
    fi
    for attempt in 1 2 3; do
        read_password
        password="$REPLY"
        response=$(printf '%s' "$password" | curl -sS --max-time 10 \
            --data-binary @- -w $'\n%{http_code}' \
            "$SERVER_URL/api/login" 2>/dev/null)
        status="${response##*$'\n'}"
        token="${response%%$'\n'*}"
        password=""
        REPLY=""
        if [[ "$status" == "200" && -n "$token" ]]; then
            AUTH_HEADER=(--header "Authorization: Bearer $token")
            echo -e "  ${GREEN}登录成功${RESET}"
            sleep 0.4
            return 0
        fi
        if [[ "$status" == "401" ]]; then
            echo -e "  ${RED}密码或临时 token 错误（剩余 $((3-attempt)) 次）${RESET}" > /dev/tty
        else
            echo -e "  ${RED}无法连接认证服务: ${SERVER_URL}${RESET}" > /dev/tty
            return 1
        fi
    done
    echo -e "  ${RED}登录失败，已达到最大尝试次数。${RESET}" > /dev/tty
    return 1
}

# ---------- 菜单拉取 (制表符分隔, 免 jq) ----------
# 设置全局: G_HAS_RUN, G_NAMES[], G_PFX[]
fetch_menu() {
    local path="$1" resp
    resp=$(curl -s --fail --max-time 10 --get \
        --data-urlencode "path=$path" \
        "${AUTH_HEADER[@]}" \
        "$SERVER_URL/api/menu" 2>/dev/null)
    if [[ $? -ne 0 || -z "$resp" ]]; then
        echo -e "${RED}无法连接服务器: ${SERVER_URL}${RESET}" >&2
        return 1
    fi
    G_HAS_RUN=0
    G_NAMES=()
    G_PFX=()
    local line rest name pfx
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        if [[ "$line" == "HAS_RUN"$'\t'* ]]; then
            G_HAS_RUN="${line#*$'\t'}"
        elif [[ "$line" == "FOLDER"$'\t'* ]]; then
            rest="${line#FOLDER$'\t'}"
            name="${rest%%$'\t'*}"
            pfx="${rest#*$'\t'}"
            G_NAMES+=("$name")
            G_PFX+=("$pfx")
        fi
    done <<< "$resp"
    return 0
}

press_any_key() {
    echo -ne "  ${DIM}按任意键继续...${RESET}"
    stty -icanon -echo < /dev/tty 2>/dev/null
    IFS= read -r -n 1 _ < /dev/tty
    stty icanon echo < /dev/tty 2>/dev/null
}

# ---------- 下载打包 + 本地执行 ----------
run_remote() {
    local path="$1"
    clear
    echo ""
    echo -e "  ${CYAN}════════════════════════════════════════════════════${RESET}"
    echo -e "  ${GREEN}⚙ 远程拉取并本地执行 run.sh...${RESET}"
    echo -e "  ${CYAN}════════════════════════════════════════════════════${RESET}"
    echo ""

    local pack work
    pack="/tmp/itool-pack-$$.tar.gz"
    work=$(mktemp -d /tmp/itool-XXXXXX 2>/dev/null)
    if [[ -z "$work" ]]; then
        echo -e "  ${RED}创建临时目录失败${RESET}"
        press_any_key
        return 1
    fi

    echo -e "  ${DIM}下载打包: ${path:-/}${RESET}"
    if ! curl -s --fail --max-time 120 --get \
            --data-urlencode "path=$path" \
            "${AUTH_HEADER[@]}" \
            -o "$pack" "$SERVER_URL/api/pack" 2>/dev/null; then
        echo -e "  ${RED}下载失败${RESET}"
        rm -rf "$work" "$pack"
        press_any_key
        return 1
    fi
    if ! tar -xzf "$pack" -C "$work" 2>/dev/null; then
        echo -e "  ${RED}解压失败 (服务端可能未找到该目录)${RESET}"
        rm -rf "$work" "$pack"
        press_any_key
        return 1
    fi
    rm -f "$pack"

    if [[ ! -f "$work/run.sh" ]]; then
        echo -e "  ${RED}包内未找到 run.sh${RESET}"
        ls -la "$work"
        rm -rf "$work"
        press_any_key
        return 1
    fi

    echo -e "  ${CYAN}工作目录: ${work}${RESET}"
    echo -e "  ${CYAN}────────────────────────────────────────────────────${RESET}"
    echo ""

    # stdin 显式指向 /dev/tty, 让 run.sh 中的 read -p 等交互可用
    ( cd "$work" && bash run.sh ) < /dev/tty
    local ec=$?

    echo ""
    echo -e "  ${CYAN}────────────────────────────────────────────────────${RESET}"
    echo -e "  ${GREEN}✓ 完成${RESET} (退出码: $ec)  ${DIM}目录保留: ${work}${RESET}"
    echo -e "  ${CYAN}────────────────────────────────────────────────────${RESET}"
    press_any_key
}

# ---------- 导航主循环 (复刻 itool.sh 的 TUI) ----------
navigate() {
    local cur="" depth=0 selected=0
    local stack=("")
    save_tty

    while true; do
        fetch_menu "$cur" || { sleep 2; return 1; }

        local options=() prefixes=()
        if [[ "$G_HAS_RUN" == "1" ]]; then
            options+=("run.sh")
            prefixes+=("0")
        fi
        local i
        for ((i=0; i<${#G_NAMES[@]}; i++)); do
            options+=("${G_NAMES[$i]}")
            prefixes+=("${G_PFX[$i]}")
        done

        local total=${#options[@]}
        [[ $selected -ge $total ]] && selected=0
        [[ $selected -lt 0 ]] && selected=0

        # ===== 渲染 =====
        clear
        echo ""
        echo -e "  ${CYAN}════════════════════════════════════════════════════${RESET}"
        echo -e "  ${WHITE}  📁 itool 远程菜单  ${DIM}${SERVER_URL}${RESET}"
        echo -e "  ${CYAN}════════════════════════════════════════════════════${RESET}"
        echo -e "  ${CYAN}────────────────────────────────────────────────────${RESET}"
        echo -e "  📂 ${cur:-/}"
        echo -e "  ${CYAN}────────────────────────────────────────────────────${RESET}"

        if [[ $total -eq 0 ]]; then
            echo -e "  ${DIM}（无可执行项, 按 Bksp 返回）${RESET}"
        fi

        for ((i=0; i<${#options[@]}; i++)); do
            if [[ $i -eq $selected ]]; then
                echo -e "  ${GREEN}▶${RESET} ${prefixes[$i]} ${WHITE}${options[$i]}${RESET}"
            else
                echo -e "    ${DIM}[${prefixes[$i]}]${RESET} ${options[$i]}"
            fi
        done
        for ((i=${#options[@]}; i<8; i++)); do echo ""; done

        echo -e "  ${CYAN}────────────────────────────────────────────────────${RESET}"
        echo -e "  ${YELLOW}↑↓${RESET} 移动  ${YELLOW}Enter${RESET} 确认  ${YELLOW}Bksp${RESET} 返回  ${YELLOW}*${RESET} 根目录  ${YELLOW}ESC${RESET} 退出"
        echo ""

        # ===== 读按键 (走 /dev/tty) =====
        stty -icanon -echo min 1 time 0 < /dev/tty 2>/dev/null
        local key="" sec=""
        IFS= read -r -n 1 key < /dev/tty
        if [[ $? -ne 0 && -z "$key" ]]; then stty icanon echo < /dev/tty 2>/dev/null; echo -e "\n  ${RED}终端读取失败, 退出。${RESET}" >&2; exit 1; fi
        if [[ "$key" == $'\e' ]]; then
            # bash3.2 不支持 -t 0.1, 用 VMIN=0/VTIME=1(约100ms) + dd 探测后续字节
            stty min 0 time 1 < /dev/tty 2>/dev/null
            sec=$(dd bs=1 count=1 < /dev/tty 2>/dev/null)
            if [[ -n "$sec" ]]; then
                key="$key$sec"
                if [[ "$sec" == "[" || "$sec" == "O" ]]; then
                    sec=$(dd bs=1 count=1 < /dev/tty 2>/dev/null)
                    key="$key$sec"
                fi
            fi
            stty min 1 time 0 < /dev/tty 2>/dev/null
        fi
        stty icanon echo < /dev/tty 2>/dev/null

        case "$key" in
            $'\e[A')  # 上
                ((selected--))
                [[ $selected -lt 0 ]] && selected=$((total-1))
                continue
                ;;
            $'\e[B')  # 下
                ((selected++))
                [[ $selected -ge $total ]] && selected=0
                continue
                ;;
            $'\b'|$'\177')  # Backspace 返回上一层
                if [[ ${#stack[@]} -gt 1 ]]; then
                    unset "stack[$(( ${#stack[@]} - 1 ))]"
                    cur="${stack[$(( ${#stack[@]} - 1 ))]}"
                    ((depth--))
                    selected=0
                fi
                continue
                ;;
            $'\e')  # 单独 ESC = 退出
                clear
                echo -e "  ${CYAN}👋 再见!${RESET}"
                echo
                if [[ $_sourced -eq 1 ]]; then
                    return 0 2>/dev/null
                else
                    exit 0
                fi
                ;;
            ""|$'\n'|$'\r')  # Enter
                ;;
            \*)  # 回根目录
                cur=""
                stack=("")
                depth=0
                selected=0
                continue
                ;;
            *)  # 数字/字母快速跳转
                local k
                k=$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')
                [[ ! "$k" =~ ^[0-9a-z]$ ]] && continue
                local found=-1 j
                for ((j=0; j<${#prefixes[@]}; j++)); do
                    [[ "${prefixes[$j]}" == "$k" ]] && found=$j
                done
                [[ $found -lt 0 ]] && continue
                selected=$found
                ;;
        esac

        # ===== 执行选中项 =====
        local choice="${options[$selected]}"

        if [[ "$choice" == "run.sh" ]]; then
            run_remote "$cur"
            selected=0
        elif [[ -n "$choice" ]]; then
            if [[ -n "$cur" ]]; then
                cur="$cur/$choice"
            else
                cur="$choice"
            fi
            stack+=("$cur")
            ((depth++))
            selected=0
            if [[ $depth -ge $MAX_DEPTH ]]; then
                echo -e "  ${RED}⚠ 达到最大深度!${RESET}"
                sleep 1
                unset "stack[$(( ${#stack[@]} - 1 ))]"
                cur="${stack[$(( ${#stack[@]} - 1 ))]}"
                ((depth--))
            fi
        fi
    done
}

authenticate || exit 1
navigate "$@"
